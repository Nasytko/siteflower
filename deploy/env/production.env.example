# SiteFlower production environment template (HostFly / Ubuntu).
# Copy to /etc/siteflower/production.env and fill real values.
# NEVER commit a filled production.env to Git.
#
# Permissions: chmod 640 /etc/siteflower/production.env
# Owner: root:siteflower (or root:root with deploy membership as designed)

# --- Application ---
NODE_ENV=production
APP_NAME=bouquet-one
APP_VERSION=0.0.0
BUSINESS_TIMEZONE=Europe/Minsk
LOG_LEVEL=info

# Public HTTPS origin (storefront + admin). Used by SEO / CORS / cookies.
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
# Internal SSR rewrite target is set by Compose to http://api:3001.
# Keep a public-facing note for operators; browser calls go same-origin via Nginx.
API_URL=http://api:3001
WEB_PORT=3000
API_PORT=3001

# Exact browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=https://YOUR_DOMAIN
TRUST_PROXY=true

# --- PostgreSQL (Docker service "postgres", not public) ---
POSTGRES_USER=siteflower
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=siteflower
# MUST use Docker DNS hostname "postgres" (not localhost).
# Password must be URL-encoded if it contains special characters (@ : / # ? etc).
DATABASE_URL=postgresql://siteflower:CHANGE_ME_LONG_RANDOM@postgres:5432/siteflower?schema=public

# --- Security ---
# Generate: openssl rand -base64 48
SESSION_HMAC_SECRET=CHANGE_ME_SESSION_HMAC_AT_LEAST_32_CHARS
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
ORDER_RECOVERY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
ORDER_RECOVERY_TTL_HOURS=48
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=1800
SESSION_LAST_USED_THROTTLE_SECONDS=60
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL_MS=60000
LOGIN_THROTTLE_LIMIT=5
# SWAGGER_ENABLED=false

# --- SEO ---
ALLOW_INDEXING=false

# --- Media (production MUST use S3 / HostFly object storage) ---
MEDIA_STORAGE=s3
MEDIA_MAX_BYTES=8000000
# HostFly S3-compatible values (obtain from HostFly panel):
S3_ENDPOINT=https://YOUR_HOSTFLY_S3_ENDPOINT
S3_REGION=auto
S3_BUCKET=YOUR_BUCKET
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# Public HTTPS base for browser/CDN delivery of objects:
S3_PUBLIC_BASE_URL=https://YOUR_PUBLIC_OBJECT_BASE
# Path-style is required for most HostFly / MinIO-compatible endpoints (default true).
S3_FORCE_PATH_STYLE=true

# --- Integrations (leave disabled until NewERP is ready) ---
INTEGRATION_MODE=DISABLED
# INTEGRATION_ENABLED=false
# INTEGRATION_KEY_ID=
# INTEGRATION_HMAC_SECRET=
# INTEGRATION_ENDPOINT=

# --- Optional ---
# REVALIDATE_SECRET=
# BACKUP_RETENTION_DAYS=14
# SITEFLOWER_DOMAIN=YOUR_DOMAIN
