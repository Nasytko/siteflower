# SiteFlower production image build context.
# Keep local .env / secrets / media / tooling out of images.

.git
.github
.cursor
.vscode
.idea

**/node_modules
**/.pnpm-store
**/.turbo
**/.next
**/dist
**/coverage
**/playwright-report
**/test-results
**/blob-report
**/artifacts
**/storage
apps/api/storage

.env
.env.*
!.env.example
deploy/env/production.env.example

*.log
*.pem
.tmp-*
.tmp-prod-verify/
api-out.log
api-err.log
web-out.log
web-err.log

# Local / editor / e2e tooling (not needed in image build context)
playwright.config.ts
.editorconfig
.prettierrc
.prettierignore

e2e
docs
README.md
**/*.md
!packages/**/README.md

**/*.test.ts
**/*.spec.ts
**/test
apps/api/test

Dockerfile*
docker-compose*.yml
deploy/docker-compose.prod.yml
