// Catalog domain + admin auth control plane (docs/database.md, docs/catalog.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin auth (Phase 1)
// ---------------------------------------------------------------------------

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  CONTENT_MANAGER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL
  ADMIN_USER_CREATED
  ADMIN_USER_UPDATED
  ADMIN_USER_DISABLED
  ADMIN_USER_ENABLED
  ADMIN_PASSWORD_RESET
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DUPLICATED
  PRODUCT_PUBLISHED
  PRODUCT_UNPUBLISHED
  PRODUCT_ARCHIVED
  PRODUCT_VARIANT_CHANGED
  PRODUCT_MEDIA_ADDED
  PRODUCT_MEDIA_REMOVED
  PRODUCT_MEDIA_REORDERED
  TAXONOMY_CREATED
  TAXONOMY_UPDATED
  TAXONOMY_DELETED
  SEO_UPDATED
  STOREFRONT_SETTINGS_UPDATED
  HOMEPAGE_CONFIG_UPDATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  FULFILLMENT_SETTINGS_UPDATED
  PROMOTION_UPDATED
  BESTSELLER_UPDATED
  BUDGET_RANGE_UPDATED
  SELLER_LEGAL_DETAILS_UPDATED
  BANK_DETAILS_UPDATED
  TRADE_REGISTER_DETAILS_UPDATED
  LEGAL_DOCUMENT_UPDATED
  LEGAL_DOCUMENT_PUBLISHED
  INTEGRATION_ENABLED
  INTEGRATION_DISABLED
  INTEGRATION_CONFIG_UPDATED
  INTEGRATION_TEST_CONNECTION
  INTEGRATION_EVENT_MANUAL_RETRY
  INTEGRATION_TEST_EVENT_SENT
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique @db.VarChar(320)
  displayName  String          @map("display_name") @db.VarChar(120)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  role         AdminRole
  status       AdminUserStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(3)

  sessions  AdminSession[]
  auditLogs AuditLog[]     @relation("AuditActor")

  @@index([status])
  @@index([role, status])
  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime  @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipHash      String?   @map("ip_hash") @db.Char(64)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([adminUserId, revokedAt])
  @@map("admin_sessions")
}

model AuditLog {
  id               String      @id @default(uuid()) @db.Uuid
  actorAdminUserId String?     @map("actor_admin_user_id") @db.Uuid
  action           AuditAction
  entityType       String      @map("entity_type") @db.VarChar(64)
  entityId         String?     @map("entity_id") @db.Uuid
  metadata         Json?
  requestId        String?     @map("request_id") @db.VarChar(64)
  ipHash           String?     @map("ip_hash") @db.Char(64)
  userAgent        String?     @map("user_agent") @db.VarChar(512)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminUser? @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorAdminUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog enums (Phase 2)
// ---------------------------------------------------------------------------

enum ProductLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommercialAvailability {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  PREORDER
  SEASONAL
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum TaxonomyVisibility {
  VISIBLE
  HIDDEN
}

enum ComponentUnit {
  PIECE
  STEM
  BUNCH
  UNSPECIFIED
}

enum SlugEntityType {
  PRODUCT
  OCCASION
  RECIPIENT
  COLOR
  FLOWER
  BOUQUET_SIZE
  CATALOG_CATEGORY
}

enum CatalogFilterType {
  SELECT
  MULTI_SELECT
  RANGE
  TOGGLE
  CHECKBOX
  NUMBER_RANGE
}

/// Storefront main menu target — independent of CatalogCategory hierarchy.
enum NavigationTargetType {
  CATEGORY
  PROMOTIONS
  BESTSELLERS
  PAGE
  CUSTOM_URL
}

enum MediaFormat {
  JPEG
  PNG
  WEBP
  AVIF
}

enum PromotionType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------------------
// Taxonomies & discovery dimensions
// ---------------------------------------------------------------------------

model Flower {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  components ProductComponent[]

  @@index([visibility, sortOrder])
  @@map("flowers")
}

model Occasion {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductOccasion[]

  @@index([visibility, sortOrder])
  @@map("occasions")
}

model Recipient {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductRecipient[]

  @@index([visibility, sortOrder])
  @@map("recipients")
}

model Color {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  /// Optional CSS color for swatch UI (complex names may omit).
  swatch         String?            @db.VarChar(32)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductColor[]

  @@index([visibility, sortOrder])
  @@map("colors")
}

/// Customer-facing bouquet size (Маленький / Средний / …) — Admin-managed.
model BouquetSize {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([visibility, sortOrder])
  @@map("bouquet_sizes")
}

/// Product line / format (Моно букеты Роза, композиции в шляпной коробке, …).
/// No SEO landings yet — filter facet only (like BouquetSize).
model ProductLine {
  id          String             @id @default(uuid()) @db.Uuid
  slug        String             @unique @db.VarChar(120)
  name        String             @db.VarChar(120)
  description String?            @db.VarChar(2000)
  sortOrder   Int                @default(0) @map("sort_order")
  visibility  TaxonomyVisibility @default(VISIBLE)
  version     Int                @default(1)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductProductLine[]

  @@index([visibility, sortOrder])
  @@map("product_lines")
}

/// Admin-managed budget filter ranges (labels + min/max minor BYN).
model BudgetRange {
  id        String             @id @default(uuid()) @db.Uuid
  label     String             @db.VarChar(80)
  /// Inclusive lower bound in minor units; null = no lower bound.
  minMinor  BigInt?            @map("min_minor")
  /// Inclusive upper bound in minor units; null = no upper bound.
  maxMinor  BigInt?            @map("max_minor")
  sortOrder Int                @default(0) @map("sort_order")
  active    Boolean            @default(true)
  version   Int                @default(1)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active, sortOrder])
  @@map("budget_ranges")
}

// ---------------------------------------------------------------------------
// Catalog navigation (tree) — separate from discovery taxonomies (occasion/color/…)
// ---------------------------------------------------------------------------

/// Storefront navigation / PLP tree (Цветы → Розы, Букеты → …).
/// Not sellable. Not ProductFamily. Not a ProductVariant.
model CatalogCategory {
  id             String             @id @default(uuid()) @db.Uuid
  parentId       String?            @map("parent_id") @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  /// Optional UI hint: FLOWERS | BOUQUETS | COMPOSITIONS | GIFTS | OTHER
  listingKind    String?            @map("listing_kind") @db.VarChar(32)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   CatalogCategory?  @relation("CatalogCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children CatalogCategory[] @relation("CatalogCategoryTree")
  products Product[]
  filters  CatalogCategoryFilter[]

  @@index([parentId, sortOrder])
  @@index([visibility, sortOrder])
  @@map("catalog_categories")
}

/// Global pool of catalog filter definitions (not category-specific options).
model CatalogFilterDefinition {
  id               String            @id @default(uuid()) @db.Uuid
  key              String            @unique @db.VarChar(64)
  name             String            @db.VarChar(120)
  description      String?           @db.VarChar(500)
  filterType       CatalogFilterType @map("filter_type")
  sourceKey        String            @map("source_key") @db.VarChar(64)
  supported        Boolean           @default(true)
  defaultEnabled   Boolean           @default(false) @map("default_enabled")
  defaultSortOrder Int               @default(0) @map("default_sort_order")
  configSchema     Json?             @map("config_schema")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoryFilters CatalogCategoryFilter[]

  @@map("catalog_filter_definitions")
}

/// Per-category filter configuration from the global pool.
model CatalogCategoryFilter {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  definitionId  String   @map("definition_id") @db.Uuid
  enabled       Boolean  @default(true)
  position      Int      @default(0)
  labelOverride String?  @map("label_override") @db.VarChar(120)
  config        Json?
  collapsed     Boolean  @default(false)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   CatalogCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  definition CatalogFilterDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([categoryId, definitionId])
  @@index([categoryId, position])
  @@map("catalog_category_filters")
}

/// Flower species / type (Роза, Хризантема) — dictionary level 1, not composition Flower.
model FlowerType {
  id         String             @id @default(uuid()) @db.Uuid
  slug       String             @unique @db.VarChar(120)
  name       String             @db.VarChar(120)
  sortOrder  Int                @default(0) @map("sort_order")
  visibility TaxonomyVisibility @default(VISIBLE)
  version    Int                @default(1)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  forms     FlowerForm[]
  varieties FlowerVariety[]
  items     FlowerItem[]
  /// @deprecated Prefer composition → FlowerItem.flowerTypeId for discovery.
  products  Product[]

  @@index([visibility, sortOrder])
  @@map("flower_types")
}

/// Contextual form under a FlowerType (Роза → Классическая / Кустовая / Пионовидная).
/// Not a global enum — each FlowerType has its own forms.
model FlowerForm {
  id           String             @id @default(uuid()) @db.Uuid
  flowerTypeId String             @map("flower_type_id") @db.Uuid
  slug         String             @db.VarChar(120)
  name         String             @db.VarChar(120)
  sortOrder    Int                @default(0) @map("sort_order")
  visibility   TaxonomyVisibility @default(VISIBLE)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  flowerType FlowerType   @relation(fields: [flowerTypeId], references: [id], onDelete: Cascade)
  items      FlowerItem[]

  @@unique([flowerTypeId, slug])
  @@index([flowerTypeId, sortOrder])
  @@index([visibility, sortOrder])
  @@map("flower_forms")
}

/// Cultivar / variety (Мондиаль, Жизель) under a FlowerType — dictionary level 2.
model FlowerVariety {
  id           String             @id @default(uuid()) @db.Uuid
  flowerTypeId String             @map("flower_type_id") @db.Uuid
  slug         String             @unique @db.VarChar(120)
  name         String             @db.VarChar(120)
  sortOrder    Int                @default(0) @map("sort_order")
  visibility   TaxonomyVisibility @default(VISIBLE)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  flowerType FlowerType   @relation(fields: [flowerTypeId], references: [id], onDelete: Cascade)
  items      FlowerItem[]
  /// @deprecated Prefer composition → FlowerItem.flowerVarietyId.
  products   Product[]

  @@index([flowerTypeId, sortOrder])
  @@index([visibility, sortOrder])
  @@map("flower_varieties")
}

/// Origin / provenance (Эквадор, Кения, Фермерская) — dictionary level.
model FlowerOrigin {
  id         String             @id @default(uuid()) @db.Uuid
  slug       String             @unique @db.VarChar(120)
  name       String             @db.VarChar(120)
  sortOrder  Int                @default(0) @map("sort_order")
  visibility TaxonomyVisibility @default(VISIBLE)
  version    Int                @default(1)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  items FlowerItem[]
  /// @deprecated Prefer composition → FlowerItem.flowerOriginId.
  products Product[]

  @@index([visibility, sortOrder])
  @@map("flower_origins")
}

/// Concrete reusable stem/SKU line: Type + optional Form + Variety + Origin + stem length.
/// Quantity never lives here — only on ProductComponent.
/// Future ERP mapping should target this entity (separate mapping table preferred).
model FlowerItem {
  id              String             @id @default(uuid()) @db.Uuid
  flowerTypeId    String             @map("flower_type_id") @db.Uuid
  flowerFormId    String?            @map("flower_form_id") @db.Uuid
  flowerVarietyId String?            @map("flower_variety_id") @db.Uuid
  flowerOriginId  String?            @map("flower_origin_id") @db.Uuid
  /// Stem / flower height in cm (NOT bouquet height — that is Product.bouquetHeightCm).
  stemLengthCm    Int?               @map("height_cm")
  /// Stable uniqueness: type|form|_|variety|_|origin|_|stem|_
  identityKey     String             @unique @map("identity_key") @db.VarChar(200)
  slug            String             @unique @db.VarChar(160)
  /// Canonical label, e.g. "Роза Мондиаль 60 см Эквадор"
  name            String             @db.VarChar(200)
  sortOrder       Int                @default(0) @map("sort_order")
  visibility      TaxonomyVisibility @default(VISIBLE)
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  flowerType    FlowerType     @relation(fields: [flowerTypeId], references: [id], onDelete: Restrict)
  flowerForm    FlowerForm?    @relation(fields: [flowerFormId], references: [id], onDelete: Restrict)
  flowerVariety FlowerVariety? @relation(fields: [flowerVarietyId], references: [id], onDelete: Restrict)
  flowerOrigin  FlowerOrigin?  @relation(fields: [flowerOriginId], references: [id], onDelete: Restrict)
  components    ProductComponent[]

  @@index([flowerTypeId, sortOrder])
  @@index([flowerFormId])
  @@index([flowerVarietyId])
  @@index([flowerOriginId])
  @@index([stemLengthCm])
  @@index([visibility, sortOrder])
  @@map("flower_items")
}

/// Logical link between sellable Products (e.g. Роза Мондиаль sizes).
/// Not purchasable. No price, stock, lifecycle, media, or sitemap entry.
model ProductFamily {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members ProductFamilyMember[]

  @@map("product_families")
}

model ProductFamilyMember {
  familyId  String @map("family_id") @db.Uuid
  productId String @unique @map("product_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  family  ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([familyId, productId])
  @@index([familyId, sortOrder])
  @@map("product_family_members")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id               String                  @id @default(uuid()) @db.Uuid
  slug             String                  @unique @db.VarChar(160)
  name             String                  @db.VarChar(200)
  shortDescription String?                 @map("short_description") @db.VarChar(500)
  description      String?                 @db.Text
  /// Bouquet/card height for ruler. Stem length lives on FlowerItem.stemLengthCm.
  bouquetHeightCm  Int?                    @map("height_cm")
  bouquetSizeId    String?                 @map("bouquet_size_id") @db.Uuid
  catalogCategoryId String?                @map("catalog_category_id") @db.Uuid
  /// @deprecated Prefer ProductComponent → FlowerItem. Kept for legacy filters/migration.
  flowerTypeId     String?                 @map("flower_type_id") @db.Uuid
  /// @deprecated Prefer ProductComponent → FlowerItem.
  flowerVarietyId  String?                 @map("flower_variety_id") @db.Uuid
  /// @deprecated Prefer ProductComponent → FlowerItem.
  flowerOriginId   String?                 @map("flower_origin_id") @db.Uuid
  lifecycle        ProductLifecycle        @default(DRAFT)
  availability     CommercialAvailability  @default(AVAILABLE)
  currency         String                  @default("BYN") @db.Char(3)
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz(3)
  publishAt        DateTime?               @map("publish_at") @db.Timestamptz(3)
  unpublishAt      DateTime?               @map("unpublish_at") @db.Timestamptz(3)
  version          Int                     @default(1)
  seoTitle         String?                 @map("seo_title") @db.VarChar(200)
  seoDescription   String?                 @map("seo_description") @db.VarChar(500)
  noIndex          Boolean                 @default(false) @map("no_index")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  bouquetSize      BouquetSize?             @relation(fields: [bouquetSizeId], references: [id], onDelete: SetNull)
  catalogCategory  CatalogCategory?         @relation(fields: [catalogCategoryId], references: [id], onDelete: SetNull)
  flowerType       FlowerType?              @relation(fields: [flowerTypeId], references: [id], onDelete: SetNull)
  flowerVariety    FlowerVariety?           @relation(fields: [flowerVarietyId], references: [id], onDelete: SetNull)
  flowerOrigin     FlowerOrigin?            @relation(fields: [flowerOriginId], references: [id], onDelete: SetNull)
  familyMember     ProductFamilyMember?
  variants         ProductVariant[]
  media            ProductMedia[]
  components       ProductComponent[]
  occasions        ProductOccasion[]
  recipients       ProductRecipient[]
  colors           ProductColor[]
  productLines     ProductProductLine[]
  promotion        ProductPromotion?
  bestsellerLinks  BestsellerGroupProduct[]

  @@index([lifecycle, publishAt])
  @@index([lifecycle, availability])
  @@index([bouquetSizeId])
  @@index([catalogCategoryId, lifecycle])
  @@index([flowerTypeId, lifecycle])
  @@index([flowerVarietyId, lifecycle])
  @@index([flowerOriginId, lifecycle])
  @@index([bouquetHeightCm, lifecycle])
  @@index([updatedAt(sort: Desc)])
  @@map("products")
}

model ProductVariant {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  name       String        @db.VarChar(120)
  priceMinor BigInt        @map("price_minor")
  sortOrder  Int           @default(0) @map("sort_order")
  status     VariantStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product            Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotionSalePrices ProductPromotionVariantPrice[]

  @@index([productId, sortOrder])
  @@index([productId, status])
  @@map("product_variants")
}

model ProductComponent {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @map("product_id") @db.Uuid
  /// Concrete stem/SKU from flower dictionary. Source of truth for composition filters.
  flowerItemId String?       @map("flower_item_id") @db.Uuid
  /// Legacy discovery Flower (/cvety facet). Optional; prefer flowerItemId.
  /// DB CHECK product_components_flower_ref_xor: exactly one of flowerItemId / flowerId.
  flowerId     String?       @map("flower_id") @db.Uuid
  displayName  String        @map("display_name") @db.VarChar(160)
  quantity     Int?
  unit         ComponentUnit @default(UNSPECIFIED)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  flowerItem FlowerItem? @relation(fields: [flowerItemId], references: [id], onDelete: Restrict)
  flower     Flower?     @relation(fields: [flowerId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([flowerItemId])
  @@index([flowerId])
  @@map("product_components")
}

model ProductOccasion {
  productId  String @map("product_id") @db.Uuid
  occasionId String @map("occasion_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId])
  @@map("product_occasions")
}

model ProductRecipient {
  productId   String @map("product_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([productId, recipientId])
  @@index([recipientId])
  @@map("product_recipients")
}

model ProductColor {
  productId String @map("product_id") @db.Uuid
  colorId   String @map("color_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
  @@index([colorId])
  @@map("product_colors")
}

model ProductProductLine {
  productId     String @map("product_id") @db.Uuid
  productLineId String @map("product_line_id") @db.Uuid

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productLine ProductLine @relation(fields: [productLineId], references: [id], onDelete: Cascade)

  @@id([productId, productLineId])
  @@index([productLineId])
  @@map("product_product_lines")
}

// ---------------------------------------------------------------------------
// Promotions (server-authoritative pricing)
// ---------------------------------------------------------------------------

/// At most one promotion row per product. Effective state is computed at read/checkout.
model ProductPromotion {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @unique @map("product_id") @db.Uuid
  enabled    Boolean       @default(false)
  type       PromotionType
  /// 1–99 when type = PERCENT; applies to every active variant.
  percentOff Int?          @map("percent_off")
  startsAt   DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime?     @map("ends_at") @db.Timestamptz(3)
  version    Int           @default(1)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantPrices ProductPromotionVariantPrice[]

  @@index([enabled, startsAt, endsAt])
  @@map("product_promotions")
}

/// Fixed sale prices per variant (required when promotion type = FIXED).
model ProductPromotionVariantPrice {
  promotionId   String @map("promotion_id") @db.Uuid
  variantId     String @map("variant_id") @db.Uuid
  salePriceMinor BigInt @map("sale_price_minor")

  promotion ProductPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([promotionId, variantId])
  @@index([variantId])
  @@map("product_promotion_variant_prices")
}

// ---------------------------------------------------------------------------
// Bestsellers (manual merchandising — not a generic collection engine)
// ---------------------------------------------------------------------------

model BestsellerGroup {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique @db.VarChar(120)
  name      String             @db.VarChar(120)
  title     String?            @db.VarChar(160)
  sortOrder Int                @default(0) @map("sort_order")
  active    Boolean            @default(true)
  version   Int                @default(1)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products BestsellerGroupProduct[]

  @@index([active, sortOrder])
  @@map("bestseller_groups")
}

model BestsellerGroupProduct {
  groupId   String @map("group_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  group   BestsellerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([groupId, productId])
  @@index([groupId, sortOrder])
  @@index([productId])
  @@map("bestseller_group_products")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  storageKey   String      @unique @map("storage_key") @db.VarChar(512)
  mimeType     String      @map("mime_type") @db.VarChar(100)
  format       MediaFormat
  byteSize     Int         @map("byte_size")
  width        Int?
  height       Int?
  checksumSha256 String    @map("checksum_sha256") @db.Char(64)
  /// Set when the asset has zero ProductMedia refs; cleared on re-attach.
  /// Physical cleanup uses this timestamp (not createdAt) + grace period.
  orphanedAt   DateTime?   @map("orphaned_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  derivatives MediaDerivative[]
  productMedia ProductMedia[]

  @@index([orphanedAt])
  @@map("media_assets")
}

model MediaDerivative {
  id          String @id @default(uuid()) @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  width       Int
  format      MediaFormat
  storageKey  String @unique @map("storage_key") @db.VarChar(512)
  byteSize    Int    @map("byte_size")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, width, format])
  @@index([mediaAssetId])
  @@map("media_derivatives")
}

model ProductMedia {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  sortOrder    Int     @default(0) @map("sort_order")
  isPrimary    Boolean @default(false) @map("is_primary")
  alt          String? @db.VarChar(300)
  caption      String? @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// Slug redirects
// ---------------------------------------------------------------------------

model SlugRedirect {
  id         String         @id @default(uuid()) @db.Uuid
  entityType SlugEntityType @map("entity_type")
  fromSlug   String         @map("from_slug") @db.VarChar(160)
  toSlug     String         @map("to_slug") @db.VarChar(160)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([entityType, fromSlug])
  @@index([entityType, toSlug])
  @@map("slug_redirects")
}

// ---------------------------------------------------------------------------
// Storefront configuration (constrained CMS — not a page builder)
// ---------------------------------------------------------------------------

/// Named storefront menu (e.g. key = "main"). Independent of CatalogCategory.
model NavigationMenu {
  id        String               @id @default(uuid()) @db.Uuid
  key       String               @unique @db.VarChar(64)
  name      String               @db.VarChar(120)
  version   Int                  @default(1)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  items NavigationMenuItem[]

  @@map("navigation_menus")
}

/// Menu item: entity reference and/or custom URL. Hierarchy is independent of category tree.
model NavigationMenuItem {
  id           String               @id @default(uuid()) @db.Uuid
  menuId       String               @map("menu_id") @db.Uuid
  parentId     String?              @map("parent_id") @db.Uuid
  label        String               @db.VarChar(120)
  targetType   NavigationTargetType @map("target_type")
  /// CatalogCategory / BestsellerGroup id when target is an entity.
  targetId     String?              @map("target_id") @db.Uuid
  /// Static page key (dostavka, o-nas, kontakty, povod) or custom path/URL.
  customHref   String?              @map("custom_href") @db.VarChar(500)
  sortOrder    Int                  @default(0) @map("sort_order")
  enabled      Boolean              @default(true)
  openInNewTab Boolean              @default(false) @map("open_in_new_tab")
  accent       Boolean              @default(false)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  menu     NavigationMenu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationMenuItem?  @relation("NavigationMenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationMenuItem[] @relation("NavigationMenuItemTree")

  @@index([menuId, sortOrder])
  @@index([parentId, sortOrder])
  @@map("navigation_menu_items")
}

/// Singleton row (`id = 1`) for public business/contact copy.
model StorefrontSettings {
  id               Int      @id @default(1)
  brandName        String   @default("BUKET №1") @map("brand_name") @db.VarChar(120)
  city             String   @default("Гродно") @db.VarChar(120)
  phone            String?  @db.VarChar(40)
  email            String?  @db.VarChar(320)
  address          String?  @db.VarChar(300)
  workingHours     String?  @map("working_hours") @db.VarChar(500)
  deliverySummary  String?  @map("delivery_summary") @db.VarChar(2000)
  aboutSummary     String?  @map("about_summary") @db.VarChar(4000)
  instagramUrl     String?  @map("instagram_url") @db.VarChar(500)
  telegramUrl      String?  @map("telegram_url") @db.VarChar(500)
  substitutionNote String?  @map("substitution_note") @db.VarChar(1000)
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("storefront_settings")
}

/// Singleton row (`id = 1`) for homepage merchandising.
model HomepageConfig {
  id        Int      @id @default(1)
  /// Constrained JSON: hero + ordered sections (see contracts HomepageConfigDto)
  config    Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_config")
}

/// Curated Instagram posts for the homepage gallery (no live Graph API).
model InstagramPost {
  id        String   @id @default(cuid())
  imageUrl  String   @map("image_url") @db.VarChar(1000)
  postUrl   String?  @map("post_url") @db.VarChar(1000)
  caption   String?  @db.VarChar(500)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([enabled, sortOrder])
  @@map("instagram_posts")
}

// ---------------------------------------------------------------------------
// Belarus legal / compliance (seller identity + versioned legal documents)
// ---------------------------------------------------------------------------

enum LegalDocumentKind {
  ORDER_TERMS
  PRIVACY_POLICY
  RETURNS_POLICY
  DELIVERY_PAYMENT
  SUBSTITUTION_POLICY
}

enum LegalDocumentVersionStatus {
  DRAFT
  PUBLISHED
}

/// Singleton (`id = 1`) — seller legal identity, claims contacts, bank requisites.
/// Shop display phone/email/hours stay on StorefrontSettings; legal entity lives here.
model LegalEntitySettings {
  id Int @id @default(1)

  sellerType String @default("INDIVIDUAL_ENTREPRENEUR") @map("seller_type") @db.VarChar(40)
  legalName  String @map("legal_name") @db.VarChar(300)
  unp        String @db.VarChar(20)
  /// Registered / legal address (NOT automatically store or pickup).
  legalAddress String @map("legal_address") @db.VarChar(500)
  postalCode   String? @map("postal_code") @db.VarChar(20)

  stateRegistrationDate   DateTime? @map("state_registration_date") @db.Date
  stateRegistrationNumber String?   @map("state_registration_number") @db.VarChar(120)
  registeringAuthority    String?   @map("registering_authority") @db.VarChar(300)

  tradeRegisterNumber String?   @map("trade_register_number") @db.VarChar(120)
  tradeRegisterDate   DateTime? @map("trade_register_date") @db.Date

  /// Prefer filling these; public contacts page may fall back to StorefrontSettings.
  sellerPhone    String? @map("seller_phone") @db.VarChar(40)
  sellerEmail    String? @map("seller_email") @db.VarChar(320)
  businessHours  String? @map("business_hours") @db.VarChar(500)

  consumerClaimsContactName String? @map("consumer_claims_contact_name") @db.VarChar(200)
  consumerClaimsPhone       String? @map("consumer_claims_phone") @db.VarChar(40)
  consumerClaimsEmail       String? @map("consumer_claims_email") @db.VarChar(320)

  /// Physical shop / showroom — never auto-filled from legalAddress.
  physicalStoreAddress String? @map("physical_store_address") @db.VarChar(500)
  /// Pickup point — never auto-filled from legalAddress.
  pickupAddress String? @map("pickup_address") @db.VarChar(500)

  /// Only describe payment methods the business actually offers offline.
  actualOfflinePaymentDescription String? @map("actual_offline_payment_description") @db.VarChar(2000)

  /// Recipient-unavailable / failed-delivery operational rule (draft until approved).
  failedDeliveryPolicy String? @map("failed_delivery_policy") @db.VarChar(2000)

  bankAccountIban String? @map("bank_account_iban") @db.VarChar(34)
  bankName        String? @map("bank_name") @db.VarChar(200)
  bankAddress     String? @map("bank_address") @db.VarChar(500)
  bankSwift       String? @map("bank_swift") @db.VarChar(20)
  bankUnp         String? @map("bank_unp") @db.VarChar(20)

  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("legal_entity_settings")
}

model LegalDocument {
  id        String            @id @default(uuid()) @db.Uuid
  kind      LegalDocumentKind @unique
  title     String            @db.VarChar(200)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions LegalDocumentVersion[]

  @@map("legal_documents")
}

model LegalDocumentVersion {
  id          String                      @id @default(uuid()) @db.Uuid
  documentId  String                      @map("document_id") @db.Uuid
  version     Int
  status      LegalDocumentVersionStatus  @default(DRAFT)
  title       String                      @db.VarChar(200)
  /// Markdown body (admin-authored; rendered safely on storefront).
  bodyMarkdown String                     @map("body_markdown") @db.Text
  /// When this published version became effective (null for drafts).
  effectiveAt DateTime?                   @map("effective_at") @db.Timestamptz(3)
  publishedAt DateTime?                   @map("published_at") @db.Timestamptz(3)
  createdByAdminUserId String?            @map("created_by_admin_user_id") @db.Uuid
  updatedByAdminUserId String?            @map("updated_by_admin_user_id") @db.Uuid
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, status])
  @@index([documentId, publishedAt(sort: Desc)])
  @@map("legal_document_versions")
}

// ---------------------------------------------------------------------------
// Commerce — cart is client-side; orders are server-authoritative (Phase 4)
// ---------------------------------------------------------------------------

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderEventType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_COMPLETED
  ORDER_CANCELLED
}

/// Singleton (`id = 1`) — checkout/fulfillment configuration.
model FulfillmentSettings {
  id                    Int      @id @default(1)
  deliveryEnabled       Boolean  @default(true) @map("delivery_enabled")
  pickupEnabled         Boolean  @default(true) @map("pickup_enabled")
  /// Fixed delivery fee in minor units (0 = free for this phase).
  deliveryFeeMinor      BigInt   @default(0) @map("delivery_fee_minor")
  /// Minimum minutes before the start of a selected time window (Europe/Minsk).
  minLeadTimeMinutes    Int      @default(120) @map("min_lead_time_minutes")
  /// How many calendar days ahead customers may book (inclusive of today).
  maxAdvanceDays        Int      @default(14) @map("max_advance_days")
  /// Time windows JSON: [{ id, label, startMinutes, endMinutes, active, sortOrder, appliesTo: "DELIVERY"|"PICKUP"|"BOTH" }]
  timeWindows           Json     @map("time_windows")
  pickupInstructions    String?  @map("pickup_instructions") @db.VarChar(1000)
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("fulfillment_settings")
}

/// Concurrency-safe per-business-date order number counter (Europe/Minsk date).
model OrderNumberSequence {
  /// Calendar date in Europe/Minsk as YYYY-MM-DD
  businessDate String @id @map("business_date") @db.Char(10)
  lastValue    Int    @default(0) @map("last_value")

  @@map("order_number_sequences")
}

model Order {
  id                       String          @id @default(uuid()) @db.Uuid
  orderNumber              String          @unique @map("order_number") @db.VarChar(32)
  /// SHA-256 hex of the public tracking token (raw token never stored).
  trackingTokenHash        String          @unique @map("tracking_token_hash") @db.Char(64)
  /// Client idempotency key for POST /orders (unique when present).
  idempotencyKey           String          @unique @map("idempotency_key") @db.VarChar(128)
  status                   OrderStatus     @default(RECEIVED)
  fulfillmentType          FulfillmentType @map("fulfillment_type")

  purchaserName            String          @map("purchaser_name") @db.VarChar(120)
  purchaserPhoneE164       String          @map("purchaser_phone_e164") @db.VarChar(20)

  recipientName            String?         @map("recipient_name") @db.VarChar(120)
  recipientPhoneE164       String?         @map("recipient_phone_e164") @db.VarChar(20)
  surprise                 Boolean         @default(false)

  addressKnown             Boolean         @default(true) @map("address_known")
  deliveryAddress          String?         @map("delivery_address") @db.VarChar(500)
  addressDetails           String?         @map("address_details") @db.VarChar(500)

  /// Calendar date of fulfillment in Europe/Minsk (YYYY-MM-DD).
  fulfillmentDate          String          @map("fulfillment_date") @db.Char(10)
  timeWindowId             String          @map("time_window_id") @db.VarChar(64)
  timeWindowLabel          String          @map("time_window_label") @db.VarChar(120)
  timeWindowStartMinutes   Int             @map("time_window_start_minutes")
  timeWindowEndMinutes     Int             @map("time_window_end_minutes")

  cardMessage              String?         @map("card_message") @db.VarChar(500)
  anonymousCard            Boolean         @default(false) @map("anonymous_card")
  customerComment          String?         @map("customer_comment") @db.VarChar(1000)

  currency                 String          @default("BYN") @db.Char(3)
  subtotalMinor            BigInt          @map("subtotal_minor")
  deliveryFeeMinor         BigInt          @default(0) @map("delivery_fee_minor")
  totalMinor               BigInt          @map("total_minor")

  cancellationReason       String?         @map("cancellation_reason") @db.VarChar(500)
  cancelledAt              DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  confirmedAt              DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  completedAt              DateTime?       @map("completed_at") @db.Timestamptz(3)

  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items                    OrderItem[]
  events                   OrderEvent[]

  @@index([status, fulfillmentDate])
  @@index([fulfillmentDate, timeWindowStartMinutes])
  @@index([createdAt(sort: Desc)])
  @@index([purchaserPhoneE164])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  sortOrder         Int      @default(0) @map("sort_order")

  productId         String?  @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  productName       String   @map("product_name") @db.VarChar(200)
  productSlug       String   @map("product_slug") @db.VarChar(160)
  variantName       String   @map("variant_name") @db.VarChar(120)
  primaryImageUrl   String?  @map("primary_image_url") @db.VarChar(1000)

  /// Final charged unit price (immutable commercial truth).
  unitPriceMinor    BigInt   @map("unit_price_minor")
  /// Regular (pre-promotion) unit price when a promotion applied; null if none.
  originalUnitPriceMinor BigInt? @map("original_unit_price_minor")
  /// Snapshot of promotion type at order time: PERCENT | FIXED | null.
  promotionType     String?  @map("promotion_type") @db.VarChar(16)
  quantity          Int
  lineTotalMinor    BigInt   @map("line_total_minor")
  currency          String   @default("BYN") @db.Char(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sortOrder])
  @@map("order_items")
}

/// Immutable operational history for an order (distinct from security AuditLog).
model OrderEvent {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  type        OrderEventType
  fromStatus  OrderStatus?   @map("from_status")
  toStatus    OrderStatus?   @map("to_status")
  message     String?        @db.VarChar(500)
  actorAdminUserId String?   @map("actor_admin_user_id") @db.Uuid
  requestId   String?        @map("request_id") @db.VarChar(64)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Transactional outbox — written in the same DB transaction as the aggregate.
/// Delivery is at-least-once; consumers must be idempotent on eventId.
enum OutboxDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  DELIVERED
  FAILED
}

model OutboxEvent {
  id            String               @id @default(uuid()) @db.Uuid
  eventType     String               @map("event_type") @db.VarChar(64)
  aggregateType String               @map("aggregate_type") @db.VarChar(64)
  aggregateId   String               @map("aggregate_id") @db.Uuid
  schemaVersion Int                  @default(1) @map("schema_version")
  /// Immutable versioned integration payload (JSON). Built once at enqueue time.
  payload       Json
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  /// When the event becomes eligible for claim (backoff / pause).
  availableAt   DateTime             @default(now()) @map("available_at") @db.Timestamptz(3)
  status        OutboxDeliveryStatus @default(PENDING)
  attemptCount  Int                  @default(0) @map("attempt_count")
  lastAttemptAt DateTime?            @map("last_attempt_at") @db.Timestamptz(3)
  nextAttemptAt DateTime?            @map("next_attempt_at") @db.Timestamptz(3)
  deliveredAt   DateTime?            @map("delivered_at") @db.Timestamptz(3)
  /// Legacy column kept for older readers; mirrored from deliveredAt when set.
  processedAt   DateTime?            @map("processed_at") @db.Timestamptz(3)
  /// Deprecated alias of attemptCount — kept during migration window.
  attempts      Int                  @default(0)
  leaseOwner    String?              @map("lease_owner") @db.VarChar(120)
  leaseExpiresAt DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  failureCategory String?            @map("failure_category") @db.VarChar(64)
  lastErrorSanitized String?         @map("last_error_sanitized") @db.VarChar(500)
  remoteReference String?            @map("remote_reference") @db.VarChar(200)

  @@index([status, availableAt, createdAt])
  @@index([processedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([leaseExpiresAt])
  @@map("outbox_events")
}

/// Worker liveness heartbeat (one row per worker instance id).
model IntegrationWorkerHeartbeat {
  id           String   @id @db.VarChar(120)
  lastSeenAt   DateTime @map("last_seen_at") @db.Timestamptz(3)
  hostname     String?  @db.VarChar(200)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("integration_worker_heartbeats")
}

/// Simulator replay-protection nonces (dev/test / in-process simulator).
model IntegrationReplayNonce {
  id        String   @id @default(cuid())
  keyId     String   @map("key_id") @db.VarChar(120)
  nonce     String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([keyId, nonce])
  @@index([expiresAt])
  @@map("integration_replay_nonces")
}

/// Simulator accepted logical events (idempotent by eventId).
model IntegrationSimulatorReceipt {
  id               String   @id @default(cuid())
  eventId          String   @unique @map("event_id") @db.Uuid
  externalOrderId  String?  @map("external_order_id") @db.Uuid
  eventType        String   @map("event_type") @db.VarChar(64)
  schemaVersion    Int      @map("schema_version")
  acceptedAt       DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  remoteReference  String   @map("remote_reference") @db.VarChar(200)

  @@index([externalOrderId])
  @@map("integration_simulator_receipts")
}

/// Singleton runtime pause flag (id=1). Env INTEGRATION_ENABLED still gates hard disable.
model IntegrationRuntimeSettings {
  id        Int      @id @default(1)
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("integration_runtime_settings")
}

/// Safe replay of the same logical request (separate from outbox delivery).
/// Recovery ciphertext holds only minimal secrets (e.g. tracking token) under AES-256-GCM.
model IdempotencyRecord {
  id                       String   @id @default(uuid()) @db.Uuid
  /// Operation namespace, e.g. "orders.create"
  scope                    String   @db.VarChar(64)
  idempotencyKey           String   @map("idempotency_key") @db.VarChar(128)
  /// SHA-256 hex of canonical business payload (not transport fields).
  requestHash              String   @map("request_hash") @db.Char(64)
  resourceType             String   @map("resource_type") @db.VarChar(64)
  resourceId               String   @map("resource_id") @db.Uuid
  /// Binary: 12-byte IV || 16-byte auth tag || ciphertext
  encryptedRecoveryPayload Bytes    @map("encrypted_recovery_payload")
  encryptionKeyVersion     Int      @default(1) @map("encryption_key_version")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt                DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
  @@index([resourceType, resourceId])
  @@map("idempotency_records")
}
