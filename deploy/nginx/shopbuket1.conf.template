# shopbuket1 Nginx site — REFERENCE ONLY.
# Live config is rendered by deploy/lib/nginx.sh (install.sh / provision-nginx.sh)
# from PUBLIC_DOMAIN or the host of NEXT_PUBLIC_SITE_URL.
#
# Installed paths:
#   /etc/nginx/sites-available/shopbuket1
#   /etc/nginx/snippets/shopbuket1-proxy.conf
#   /etc/nginx/conf.d/shopbuket1-map.conf
#
# Do not copy this file by hand with YOUR_DOMAIN. Use:
#   sudo ./provision-nginx.sh
#
# HTTP-only until a Let's Encrypt cert exists under
# /etc/letsencrypt/live/<domain>/; then HTTP→HTTPS redirect + listen 443.

server {
    listen 80;
    listen [::]:80;
    server_name __PUBLIC_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }

    include /etc/nginx/snippets/shopbuket1-proxy.conf;
}

# After cert exists, provision-nginx also emits:
#   listen 443 ssl; + ssl_certificate paths under /etc/letsencrypt
#   and HTTP → HTTPS return 301
