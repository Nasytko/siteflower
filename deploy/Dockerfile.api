# syntax=docker/dockerfile:1.7

# shopbuket1 API image (+ optional worker / ops CLI) — multi-stage, Node 24, pnpm 10.17.
# Runtime is produced with `pnpm deploy --prod` so the image gets a self-contained
# production dependency tree (no broken workspace symlinks into a missing monorepo).
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.17.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/database/package.json packages/database/
COPY packages/contracts/package.json packages/contracts/
COPY packages/ui/package.json packages/ui/
COPY packages/config/package.json packages/config/
COPY packages/config/typescript packages/config/typescript
COPY apps/api/.npmignore apps/api/
COPY packages/database/.npmignore packages/database/
COPY packages/contracts/.npmignore packages/contracts/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
# Prisma 7 `prisma.config.ts` requires DATABASE_URL at `prisma generate` time.
# Build-only dummy — never used to open a DB connection during image build.
ENV DATABASE_URL=postgresql://prisma:prisma@127.0.0.1:5432/prisma?schema=public
RUN pnpm --filter @bouquet-one/database generate \
  && pnpm --filter @bouquet-one/contracts build \
  && pnpm --filter @bouquet-one/database build \
  && pnpm --filter @bouquet-one/api build

# Portable production tree for @bouquet-one/api (injected workspace packages).
# Do not use --legacy: shared lockfile + legacy deploy can pull unrelated workspace peers.
RUN pnpm --filter @bouquet-one/api --prod deploy /out

# Verify Nest + native + workspace packages resolve from the deploy root (Node module resolution).
# Transitive deps such as @prisma/client may live under the injected database package, not as
# top-level /out/node_modules/@prisma/* — that is expected with pnpm.
WORKDIR /out
RUN set -eux; \
  test -f dist/main.js; \
  test -f dist/worker-main.js; \
  test -d scripts; \
  test -e node_modules/.bin/prisma; \
  test -e node_modules/@bouquet-one/database/prisma/schema.prisma; \
  test -e node_modules/@bouquet-one/database/prisma.config.ts; \
  test -d node_modules/@bouquet-one/database/dist; \
  node -e "require('@nestjs/common'); require('@nestjs/core'); require('@nestjs/platform-express'); require('@nestjs/config'); require('@nestjs/swagger'); require('@nestjs/throttler'); require('@bouquet-one/contracts'); require('@bouquet-one/database'); require('argon2'); require('sharp'); require('@aws-sdk/client-s3'); console.log('api-runtime-deps-ok')"

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production \
    API_PORT=3001
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl tini curl \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 shopbuket1 \
  && useradd --uid 10001 --gid shopbuket1 --shell /usr/sbin/nologin --create-home shopbuket1
WORKDIR /app

COPY --from=build --chown=shopbuket1:shopbuket1 /out/ ./

USER shopbuket1
EXPOSE 3001

HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${API_PORT}/api/v1/health" >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/main.js"]
