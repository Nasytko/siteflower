// Catalog domain + admin auth control plane (docs/database.md, docs/catalog.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Admin auth (Phase 1)
// ---------------------------------------------------------------------------

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  CONTENT_MANAGER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL
  ADMIN_USER_CREATED
  ADMIN_USER_UPDATED
  ADMIN_USER_DISABLED
  ADMIN_USER_ENABLED
  ADMIN_PASSWORD_RESET
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_PUBLISHED
  PRODUCT_UNPUBLISHED
  PRODUCT_ARCHIVED
  PRODUCT_VARIANT_CHANGED
  PRODUCT_MEDIA_ADDED
  PRODUCT_MEDIA_REMOVED
  PRODUCT_MEDIA_REORDERED
  TAXONOMY_CREATED
  TAXONOMY_UPDATED
  COLLECTION_CREATED
  COLLECTION_UPDATED
  SEO_UPDATED
  STOREFRONT_SETTINGS_UPDATED
  HOMEPAGE_CONFIG_UPDATED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  FULFILLMENT_SETTINGS_UPDATED
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique @db.VarChar(320)
  displayName  String          @map("display_name") @db.VarChar(120)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  role         AdminRole
  status       AdminUserStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(3)

  sessions  AdminSession[]
  auditLogs AuditLog[]     @relation("AuditActor")

  @@index([status])
  @@index([role, status])
  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime  @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipHash      String?   @map("ip_hash") @db.Char(64)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@index([adminUserId, revokedAt])
  @@map("admin_sessions")
}

model AuditLog {
  id               String      @id @default(uuid()) @db.Uuid
  actorAdminUserId String?     @map("actor_admin_user_id") @db.Uuid
  action           AuditAction
  entityType       String      @map("entity_type") @db.VarChar(64)
  entityId         String?     @map("entity_id") @db.Uuid
  metadata         Json?
  requestId        String?     @map("request_id") @db.VarChar(64)
  ipHash           String?     @map("ip_hash") @db.Char(64)
  userAgent        String?     @map("user_agent") @db.VarChar(512)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminUser? @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorAdminUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog enums (Phase 2)
// ---------------------------------------------------------------------------

enum ProductLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommercialAvailability {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  PREORDER
  SEASONAL
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum TaxonomyVisibility {
  VISIBLE
  HIDDEN
}

enum CollectionType {
  MANUAL
  RULE_BASED
}

enum ComponentUnit {
  PIECE
  STEM
  BUNCH
  UNSPECIFIED
}

enum SlugEntityType {
  PRODUCT
  CATEGORY
  OCCASION
  RECIPIENT
  STYLE
  COLOR
  FLOWER
  COLLECTION
}

enum MediaFormat {
  JPEG
  PNG
  WEBP
  AVIF
}

// ---------------------------------------------------------------------------
// Taxonomies
// ---------------------------------------------------------------------------

model Flower {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  components ProductComponent[]

  @@index([visibility, sortOrder])
  @@map("flowers")
}

model Category {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductCategory[]

  @@index([visibility, sortOrder])
  @@map("categories")
}

model Occasion {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductOccasion[]

  @@index([visibility, sortOrder])
  @@map("occasions")
}

model Recipient {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductRecipient[]

  @@index([visibility, sortOrder])
  @@map("recipients")
}

model Style {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductStyle[]

  @@index([visibility, sortOrder])
  @@map("styles")
}

model Color {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(120)
  description    String?            @db.VarChar(2000)
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductColor[]

  @@index([visibility, sortOrder])
  @@map("colors")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id             String                  @id @default(uuid()) @db.Uuid
  slug           String                  @unique @db.VarChar(160)
  name           String                  @db.VarChar(200)
  shortDescription String?               @map("short_description") @db.VarChar(500)
  description    String?                 @db.Text
  lifecycle      ProductLifecycle        @default(DRAFT)
  availability   CommercialAvailability  @default(AVAILABLE)
  featured       Boolean                 @default(false)
  currency       String                  @default("BYN") @db.Char(3)
  publishedAt    DateTime?               @map("published_at") @db.Timestamptz(3)
  publishAt      DateTime?               @map("publish_at") @db.Timestamptz(3)
  unpublishAt    DateTime?               @map("unpublish_at") @db.Timestamptz(3)
  version        Int                     @default(1)
  seoTitle       String?                 @map("seo_title") @db.VarChar(200)
  seoDescription String?                 @map("seo_description") @db.VarChar(500)
  noIndex        Boolean                 @default(false) @map("no_index")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  variants    ProductVariant[]
  media       ProductMedia[]
  components  ProductComponent[]
  categories  ProductCategory[]
  occasions   ProductOccasion[]
  recipients  ProductRecipient[]
  styles      ProductStyle[]
  colors      ProductColor[]
  collections CollectionProduct[]

  @@index([lifecycle, publishAt])
  @@index([lifecycle, availability])
  @@index([featured])
  @@index([updatedAt(sort: Desc)])
  @@map("products")
}

model ProductVariant {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  name       String        @db.VarChar(120)
  priceMinor BigInt        @map("price_minor")
  sortOrder  Int           @default(0) @map("sort_order")
  status     VariantStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, status])
  @@map("product_variants")
}

model ProductComponent {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  flowerId    String?       @map("flower_id") @db.Uuid
  displayName String        @map("display_name") @db.VarChar(160)
  quantity    Int?
  unit        ComponentUnit @default(UNSPECIFIED)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  flower  Flower? @relation(fields: [flowerId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_components")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductOccasion {
  productId  String @map("product_id") @db.Uuid
  occasionId String @map("occasion_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId])
  @@map("product_occasions")
}

model ProductRecipient {
  productId   String @map("product_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([productId, recipientId])
  @@index([recipientId])
  @@map("product_recipients")
}

model ProductStyle {
  productId String @map("product_id") @db.Uuid
  styleId   String @map("style_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([productId, styleId])
  @@index([styleId])
  @@map("product_styles")
}

model ProductColor {
  productId String @map("product_id") @db.Uuid
  colorId   String @map("color_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
  @@index([colorId])
  @@map("product_colors")
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

model Collection {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique @db.VarChar(120)
  name           String             @db.VarChar(160)
  description    String?            @db.VarChar(2000)
  type           CollectionType     @default(MANUAL)
  rules          Json?
  sortOrder      Int                @default(0) @map("sort_order")
  visibility     TaxonomyVisibility @default(VISIBLE)
  version        Int                @default(1)
  seoTitle       String?            @map("seo_title") @db.VarChar(200)
  seoDescription String?            @map("seo_description") @db.VarChar(500)
  noIndex        Boolean            @default(false) @map("no_index")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  products CollectionProduct[]

  @@index([visibility, sortOrder])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, sortOrder])
  @@index([productId])
  @@map("collection_products")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  storageKey   String      @unique @map("storage_key") @db.VarChar(512)
  mimeType     String      @map("mime_type") @db.VarChar(100)
  format       MediaFormat
  byteSize     Int         @map("byte_size")
  width        Int?
  height       Int?
  checksumSha256 String    @map("checksum_sha256") @db.Char(64)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  derivatives MediaDerivative[]
  productMedia ProductMedia[]

  @@map("media_assets")
}

model MediaDerivative {
  id          String @id @default(uuid()) @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  width       Int
  format      MediaFormat
  storageKey  String @unique @map("storage_key") @db.VarChar(512)
  byteSize    Int    @map("byte_size")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, width, format])
  @@index([mediaAssetId])
  @@map("media_derivatives")
}

model ProductMedia {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  mediaAssetId String  @map("media_asset_id") @db.Uuid
  sortOrder    Int     @default(0) @map("sort_order")
  isPrimary    Boolean @default(false) @map("is_primary")
  alt          String? @db.VarChar(300)
  caption      String? @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// Slug redirects
// ---------------------------------------------------------------------------

model SlugRedirect {
  id         String         @id @default(uuid()) @db.Uuid
  entityType SlugEntityType @map("entity_type")
  fromSlug   String         @map("from_slug") @db.VarChar(160)
  toSlug     String         @map("to_slug") @db.VarChar(160)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([entityType, fromSlug])
  @@index([entityType, toSlug])
  @@map("slug_redirects")
}

// ---------------------------------------------------------------------------
// Storefront configuration (constrained CMS — not a page builder)
// ---------------------------------------------------------------------------

/// Singleton row (`id = 1`) for public business/contact copy.
model StorefrontSettings {
  id               Int      @id @default(1)
  brandName        String   @default("БУКЕТ №1") @map("brand_name") @db.VarChar(120)
  city             String   @default("Гродно") @db.VarChar(120)
  phone            String?  @db.VarChar(40)
  email            String?  @db.VarChar(320)
  address          String?  @db.VarChar(300)
  workingHours     String?  @map("working_hours") @db.VarChar(500)
  deliverySummary  String?  @map("delivery_summary") @db.VarChar(2000)
  aboutSummary     String?  @map("about_summary") @db.VarChar(4000)
  instagramUrl     String?  @map("instagram_url") @db.VarChar(500)
  telegramUrl      String?  @map("telegram_url") @db.VarChar(500)
  substitutionNote String?  @map("substitution_note") @db.VarChar(1000)
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("storefront_settings")
}

/// Singleton row (`id = 1`) for homepage merchandising.
model HomepageConfig {
  id        Int      @id @default(1)
  /// Constrained JSON: hero + ordered sections (see contracts HomepageConfigDto)
  config    Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("homepage_config")
}

// ---------------------------------------------------------------------------
// Commerce — cart is client-side; orders are server-authoritative (Phase 4)
// ---------------------------------------------------------------------------

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  RECEIVED
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderEventType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_COMPLETED
  ORDER_CANCELLED
}

/// Singleton (`id = 1`) — checkout/fulfillment configuration.
model FulfillmentSettings {
  id                    Int      @id @default(1)
  deliveryEnabled       Boolean  @default(true) @map("delivery_enabled")
  pickupEnabled         Boolean  @default(true) @map("pickup_enabled")
  /// Fixed delivery fee in minor units (0 = free for this phase).
  deliveryFeeMinor      BigInt   @default(0) @map("delivery_fee_minor")
  /// Minimum minutes before the start of a selected time window (Europe/Minsk).
  minLeadTimeMinutes    Int      @default(120) @map("min_lead_time_minutes")
  /// How many calendar days ahead customers may book (inclusive of today).
  maxAdvanceDays        Int      @default(14) @map("max_advance_days")
  /// Time windows JSON: [{ id, label, startMinutes, endMinutes, active, sortOrder, appliesTo: "DELIVERY"|"PICKUP"|"BOTH" }]
  timeWindows           Json     @map("time_windows")
  pickupInstructions    String?  @map("pickup_instructions") @db.VarChar(1000)
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("fulfillment_settings")
}

/// Concurrency-safe per-business-date order number counter (Europe/Minsk date).
model OrderNumberSequence {
  /// Calendar date in Europe/Minsk as YYYY-MM-DD
  businessDate String @id @map("business_date") @db.Char(10)
  lastValue    Int    @default(0) @map("last_value")

  @@map("order_number_sequences")
}

model Order {
  id                       String          @id @default(uuid()) @db.Uuid
  orderNumber              String          @unique @map("order_number") @db.VarChar(32)
  /// SHA-256 hex of the public tracking token (raw token never stored).
  trackingTokenHash        String          @unique @map("tracking_token_hash") @db.Char(64)
  /// Client idempotency key for POST /orders (unique when present).
  idempotencyKey           String          @unique @map("idempotency_key") @db.VarChar(128)
  status                   OrderStatus     @default(RECEIVED)
  fulfillmentType          FulfillmentType @map("fulfillment_type")

  purchaserName            String          @map("purchaser_name") @db.VarChar(120)
  purchaserPhoneE164       String          @map("purchaser_phone_e164") @db.VarChar(20)

  recipientName            String?         @map("recipient_name") @db.VarChar(120)
  recipientPhoneE164       String?         @map("recipient_phone_e164") @db.VarChar(20)
  surprise                 Boolean         @default(false)

  addressKnown             Boolean         @default(true) @map("address_known")
  deliveryAddress          String?         @map("delivery_address") @db.VarChar(500)
  addressDetails           String?         @map("address_details") @db.VarChar(500)

  /// Calendar date of fulfillment in Europe/Minsk (YYYY-MM-DD).
  fulfillmentDate          String          @map("fulfillment_date") @db.Char(10)
  timeWindowId             String          @map("time_window_id") @db.VarChar(64)
  timeWindowLabel          String          @map("time_window_label") @db.VarChar(120)
  timeWindowStartMinutes   Int             @map("time_window_start_minutes")
  timeWindowEndMinutes     Int             @map("time_window_end_minutes")

  cardMessage              String?         @map("card_message") @db.VarChar(500)
  anonymousCard            Boolean         @default(false) @map("anonymous_card")
  customerComment          String?         @map("customer_comment") @db.VarChar(1000)

  currency                 String          @default("BYN") @db.Char(3)
  subtotalMinor            BigInt          @map("subtotal_minor")
  deliveryFeeMinor         BigInt          @default(0) @map("delivery_fee_minor")
  totalMinor               BigInt          @map("total_minor")

  cancellationReason       String?         @map("cancellation_reason") @db.VarChar(500)
  cancelledAt              DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  confirmedAt              DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  completedAt              DateTime?       @map("completed_at") @db.Timestamptz(3)

  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items                    OrderItem[]
  events                   OrderEvent[]

  @@index([status, fulfillmentDate])
  @@index([fulfillmentDate, timeWindowStartMinutes])
  @@index([createdAt(sort: Desc)])
  @@index([purchaserPhoneE164])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  sortOrder         Int      @default(0) @map("sort_order")

  productId         String?  @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  productName       String   @map("product_name") @db.VarChar(200)
  productSlug       String   @map("product_slug") @db.VarChar(160)
  variantName       String   @map("variant_name") @db.VarChar(120)
  primaryImageUrl   String?  @map("primary_image_url") @db.VarChar(1000)

  unitPriceMinor    BigInt   @map("unit_price_minor")
  quantity          Int
  lineTotalMinor    BigInt   @map("line_total_minor")
  currency          String   @default("BYN") @db.Char(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, sortOrder])
  @@map("order_items")
}

/// Immutable operational history for an order (distinct from security AuditLog).
model OrderEvent {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @map("order_id") @db.Uuid
  type        OrderEventType
  fromStatus  OrderStatus?   @map("from_status")
  toStatus    OrderStatus?   @map("to_status")
  message     String?        @db.VarChar(500)
  actorAdminUserId String?   @map("actor_admin_user_id") @db.Uuid
  requestId   String?        @map("request_id") @db.VarChar(64)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Transactional outbox — written in the same DB transaction as the aggregate.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(64)
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  schemaVersion Int       @default(1) @map("schema_version")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts      Int       @default(0)

  @@index([processedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
