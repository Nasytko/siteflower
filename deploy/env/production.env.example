# shopbuket1 production environment template (HostFly / Ubuntu).
# Copy to /etc/shopbuket1/production.env and fill real values.
# NEVER commit a filled production.env to Git.
#
# Infrastructure identity is "shopbuket1" (not a public domain).
# Public domain is configuration only: NEXT_PUBLIC_SITE_URL / CORS_ORIGINS / PUBLIC_DOMAIN.
# Changing the domain later must NOT require recreating Docker volumes, Postgres, or S3 media.
#
# Sibling ERP stack uses infrastructure identity "erpbuket1".
#
# Permissions: chmod 640 /etc/shopbuket1/production.env
# Owner: root:shopbuket1

# --- Application ---
NODE_ENV=production
APP_NAME=bouquet-one
APP_VERSION=0.0.0
BUSINESS_TIMEZONE=Europe/Minsk
LOG_LEVEL=info

# Public HTTPS origin (storefront + admin). Replaceable without reinstalling the VPS.
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
# Optional Nginx server_name override (defaults to host from NEXT_PUBLIC_SITE_URL).
# PUBLIC_DOMAIN=YOUR_DOMAIN
# Internal SSR rewrite target is set by Compose to http://api:3001.
API_URL=http://api:3001
WEB_PORT=3000
API_PORT=3001

# Exact browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=https://YOUR_DOMAIN
TRUST_PROXY=true

# Let's Encrypt account email (required for sudo ./provision-nginx.sh TLS).
# CERTBOT_EMAIL=ops@example.com
# Set PROVISION_TLS=0 to configure HTTP only (not recommended for production).
# PROVISION_TLS=1

# --- PostgreSQL (Docker service "postgres", not public) ---
POSTGRES_USER=shopbuket1
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=shopbuket1
# MUST use Docker DNS hostname "postgres" (not localhost).
# Password must be URL-encoded if it contains special characters (@ : / # ? etc).
DATABASE_URL=postgresql://shopbuket1:CHANGE_ME_LONG_RANDOM@postgres:5432/shopbuket1?schema=public

# --- Security ---
# Generate: openssl rand -base64 48
SESSION_HMAC_SECRET=CHANGE_ME_SESSION_HMAC_AT_LEAST_32_CHARS
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
ORDER_RECOVERY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
ORDER_RECOVERY_TTL_HOURS=48
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=1800
SESSION_LAST_USED_THROTTLE_SECONDS=60
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL_MS=60000
LOGIN_THROTTLE_LIMIT=5

# --- SEO ---
ALLOW_INDEXING=false

# --- Media (production MUST use S3 / HostFly object storage) ---
MEDIA_STORAGE=s3
MEDIA_MAX_BYTES=25000000
S3_ENDPOINT=https://YOUR_HOSTFLY_S3_ENDPOINT
S3_REGION=auto
# Domain-neutral bucket example (ERP will use erpbuket1-media):
S3_BUCKET=shopbuket1-media
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_PUBLIC_BASE_URL=https://YOUR_PUBLIC_OBJECT_BASE
S3_FORCE_PATH_STYLE=true

# --- Integrations (leave disabled until NewERP / erpbuket1 is ready) ---
INTEGRATION_MODE=DISABLED
# INTEGRATION_ENABLED=false
# INTEGRATION_KEY_ID=
# INTEGRATION_HMAC_SECRET=
# INTEGRATION_ENDPOINT=

# --- Optional: storefront on-demand revalidation (server-to-server) ---
# Compose sets REVALIDATE_URL=http://web:3000/api/revalidate on the API container
# (Docker DNS on shopbuket1_internal). Prefer that over the public HTTPS origin.
# Set the same REVALIDATE_SECRET (≥16 chars) in this file so both api and web receive it.
# Leave secret unset to keep fail-soft no-op (safe default). Never use NEXT_PUBLIC_*.
# REVALIDATE_SECRET=
# REVALIDATE_URL=http://web:3000/api/revalidate
# BACKUP_RETENTION_DAYS=14
# Offsite DB backup copy is intentional debt — local backup.sh + host snapshots for now.
