{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "API_URL",
    "CORS_ORIGINS",
    "MEDIA_STORAGE",
    "MEDIA_LOCAL_ROOT",
    "MEDIA_PUBLIC_BASE_URL",
    "S3_PUBLIC_BASE_URL",
    "SESSION_HMAC_SECRET",
    "SESSION_ABSOLUTE_TTL_SECONDS",
    "SESSION_IDLE_TTL_SECONDS",
    "ALLOW_INDEXING",
    "SWAGGER_ENABLED",
    "TRUST_PROXY",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env.example"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/artifacts/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/artifacts/**"]
    },
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
