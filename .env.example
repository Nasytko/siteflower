# =============================================================================
# БУКЕТ №1 — Environment template
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=bouquet-one
APP_VERSION=0.0.0
BUSINESS_TIMEZONE=Europe/Minsk

# --- URLs ---
# Public site origin (used for SEO canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Commerce API origin (server-side; do not expose secrets via NEXT_PUBLIC_*)
# Prefer 127.0.0.1 over localhost on Windows to avoid IPv6 (::1) mismatches with Playwright.
API_URL=http://127.0.0.1:3001
# Port bindings
WEB_PORT=3000
API_PORT=3001

# --- Database ---
POSTGRES_USER=bouquet
POSTGRES_PASSWORD=bouquet_dev_password
POSTGRES_DB=bouquet_one
POSTGRES_PORT=5433
DATABASE_URL=postgresql://bouquet:bouquet_dev_password@localhost:5433/bouquet_one?schema=public

# --- Security / proxy ---
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Trust X-Forwarded-* from reverse proxy (set true behind Nginx)
TRUST_PROXY=false
# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL_MS=60000
LOGIN_THROTTLE_LIMIT=5

# --- Admin sessions ---
# Absolute session lifetime (12h) and idle timeout (30m)
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=1800
SESSION_LAST_USED_THROTTLE_SECONDS=60
# HMAC secret for privacy-preserving IP hashing (required in production, ≥32 chars, non-placeholder)
SESSION_HMAC_SECRET=dev-only-change-me-session-hmac

# --- Checkout idempotency recovery (AES-256-GCM) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Never commit a real key. Never log the key.
# ORDER_RECOVERY_ENCRYPTION_KEY=
# Hours to retain encrypted recovery material (tracking token) for lost-response retries
ORDER_RECOVERY_TTL_HOURS=48

# --- OpenAPI ---
# Expose Swagger UI (forced on in development; production defaults OFF unless true)
# SWAGGER_ENABLED=false

# --- SEO / indexing ---
# Non-production: leave false (noindex). Production: omit or set true; only set false to hold back indexing.
ALLOW_INDEXING=false

# --- Logging ---
LOG_LEVEL=info

# --- Media ---
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=./storage/media
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3001/api/v1/media
MEDIA_MAX_BYTES=8000000
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Dev-only catalog seed (never enable in production / never set on deploy)
# Requires ALLOW_DEV_CATALOG_SEED=true AND NODE_ENV !== production AND a non-production DATABASE_URL.
# Usage: ALLOW_DEV_CATALOG_SEED=true pnpm seed:dev-catalog
# ALLOW_DEV_CATALOG_SEED=true
# Important: do not leave NODE_ENV=development exported in your shell when running `pnpm build`
# (Next.js 16 can fail prerendering `/_global-error` with a non-production NODE_ENV).
# Prefer: Remove-Item Env:NODE_ENV (PowerShell) or unset NODE_ENV before build; web build uses cross-env NODE_ENV=production.

# --- Optional storefront cache revalidation (server-to-server) ---
# REVALIDATE_SECRET=

# --- Future integrations (placeholders only) ---
# ERP_BASE_URL=
# ERP_API_KEY=
# PAYMENT_PROVIDER=
# AI_GATEWAY_URL=
