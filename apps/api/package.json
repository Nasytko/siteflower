{
  "name": "@bouquet-one/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "rimraf dist && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest && jest --config ./test/jest-integration.json",
    "test:unit": "jest",
    "test:integration": "jest --config ./test/jest-integration.json",
    "admin:create": "tsx scripts/admin-create.ts",
    "admin:reset-password": "tsx scripts/admin-reset-password.ts",
    "seed:dev-catalog": "tsx scripts/seed-dev-catalog.ts",
    "compliance:check": "tsx scripts/compliance-check.ts",
    "media:check": "tsx scripts/media-check.ts",
    "media:cleanup": "tsx scripts/media-cleanup.ts",
    "media:repair": "tsx scripts/media-repair.ts",
    "media:migrate-local-to-s3": "tsx scripts/media-migrate-local-to-s3.ts",
    "worker": "node dist/worker-main.js",
    "worker:dev": "tsx src/worker-main.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@bouquet-one/contracts": "workspace:*",
    "@bouquet-one/database": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/throttler": "6.4.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.2",
    "file-type": "16.5.4",
    "helmet": "8.1.0",
    "multer": "^2.4.0",
    "nestjs-pino": "4.4.0",
    "pino": "9.9.5",
    "pino-http": "10.5.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.4",
    "tsx": "4.20.5",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@bouquet-one/config": "workspace:*",
    "@eslint/js": "9.36.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "eslint": "9.36.0",
    "jest": "30.1.3",
    "pg": "8.16.3",
    "pino-pretty": "13.1.1",
    "rimraf": "6.0.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0"
  }
}
