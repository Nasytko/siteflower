{
  "name": "@bouquet-one/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./cjs-bridge.cjs",
      "default": "./dist/index.js"
    },
    "./cjs-bridge.cjs": "./cjs-bridge.cjs"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist src/generated",
    "test": "node --import tsx --test src/money.test.ts"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "cjs-bridge.cjs"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.2.2",
    "pg": "8.16.3",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@bouquet-one/config": "workspace:*",
    "@eslint/js": "9.36.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "eslint": "9.36.0",
    "rimraf": "6.0.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0"
  }
}
