{
  "name": "bouquet-one",
  "private": true,
  "version": "0.0.0",
  "description": "БУКЕТ №1 — flower commerce platform for Grodno, Belarus",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @bouquet-one/database generate",
    "db:migrate": "pnpm --filter @bouquet-one/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @bouquet-one/database migrate:deploy",
    "db:studio": "pnpm --filter @bouquet-one/database studio",
    "admin:create": "pnpm --filter @bouquet-one/api admin:create",
    "seed:dev-catalog": "pnpm --filter @bouquet-one/api seed:dev-catalog",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "turbo": "2.11.2",
    "typescript": "5.9.3"
  }
}
